{
  "name": "insights-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/insights-service/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": { "command": "npm run build", "cwd": "apps/insights-service" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "npm test", "cwd": "apps/insights-service" }
    }
  }
}
